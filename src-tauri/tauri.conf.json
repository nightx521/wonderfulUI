{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WonderfulUI",
  "version": "1.1.0",
  "identifier": "app.local.wonderfului",
  "build": {
    "frontendDist": "../packages/gui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run --cwd packages/gui dev",
    "beforeBuildCommand": "bun run --cwd packages/gui build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WonderfulUI",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "devtools": true,
        "additionalBrowserArgs": "--force-prefers-no-reduced-motion"
      }
    ],
    "security": {
      "csp": {
        "default-src": [
          "'self'"
        ],
        "script-src": [
          "'self'"
        ],
        "style-src": [
          "'self'",
          "'unsafe-inline'"
        ],
        "img-src": [
          "'self'",
          "asset:",
          "http://asset.localhost",
          "data:",
          "blob:"
        ],
        "font-src": [
          "'self'",
          "data:"
        ],
        "media-src": [
          "'self'",
          "asset:",
          "http://asset.localhost",
          "blob:"
        ],
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost"
        ],
        "object-src": [
          "'none'"
        ],
        "base-uri": [
          "'none'"
        ],
        "form-action": [
          "'none'"
        ],
        "frame-ancestors": [
          "'none'"
        ]
      },
      "devCsp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$LOCALDATA/wonderful-ui/assets/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "installMode": "perMachine",
        "installerHooks": "windows/installer-hooks.nsh",
        "template": "installer.nsi",
        "installerIcon": "icons/icon.ico"
      }
    },
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "LICENSE",
      "../NOTICE.md": "NOTICE.md"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.murainy.com/https://github.com/nightx521/wonderfulUI/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRGQTdDNEU0Mjg4MEMyRTQKUldUa3dvQW81TVNuVDNocGVpd2ZOZlVXRVZHVU5Fby82Q3hML2QvZm5OazI3R1prQXJKZGVia2EK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
